{
  "info": {
    "name": "FinTrack API",
    "description": "Full FinTrack API collection: auth flow, CRUD for accounts/categories/transactions/users, plus validation-error and blocked (403) examples.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dina\",\n  \"email\": \"dina@fintrack.dev\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Login (saves token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.access_token) {",
                  "  pm.environment.set('token', res.access_token);",
                  "  console.log('Saved token to environment');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@fintrack.dev\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Login as non-admin (Budi, saves userToken)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.access_token) { pm.environment.set('userToken', res.access_token); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"budi@fintrack.dev\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Login - validation error (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"not-an-email\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Create user",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Eka\",\n  \"email\": \"eka@fintrack.dev\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "List users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] }
          }
        },
        {
          "name": "Get user with accounts (nested)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/users/1", "host": ["{{baseUrl}}"], "path": ["users", "1"] }
          }
        }
      ]
    },
    {
      "name": "Accounts",
      "item": [
        {
          "name": "Create account",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/accounts", "host": ["{{baseUrl}}"], "path": ["accounts"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Travel Fund\",\n  \"type\": \"bank\",\n  \"balance\": 1000000\n}"
            }
          }
        },
        {
          "name": "Create account - validation error (400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/accounts", "host": ["{{baseUrl}}"], "path": ["accounts"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bad\",\n  \"type\": \"crypto\"\n}"
            }
          }
        },
        {
          "name": "List accounts",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/accounts", "host": ["{{baseUrl}}"], "path": ["accounts"] }
          }
        },
        {
          "name": "Get account",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/accounts/1", "host": ["{{baseUrl}}"], "path": ["accounts", "1"] }
          }
        },
        {
          "name": "Get account transactions (nested category)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/accounts/2/transactions", "host": ["{{baseUrl}}"], "path": ["accounts", "2", "transactions"] }
          }
        },
        {
          "name": "Update account",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/accounts/1", "host": ["{{baseUrl}}"], "path": ["accounts", "1"] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Alice Petty Cash\"\n}" }
          }
        },
        {
          "name": "Delete account",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/accounts/7", "host": ["{{baseUrl}}"], "path": ["accounts", "7"] }
          }
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "Create category",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/categories", "host": ["{{baseUrl}}"], "path": ["categories"] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Health\",\n  \"type\": \"expense\"\n}" }
          }
        },
        {
          "name": "List categories",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/categories", "host": ["{{baseUrl}}"], "path": ["categories"] }
          }
        },
        {
          "name": "Get category",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/categories/3", "host": ["{{baseUrl}}"], "path": ["categories", "3"] }
          }
        },
        {
          "name": "Update category",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/categories/8", "host": ["{{baseUrl}}"], "path": ["categories", "8"] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Healthcare\"\n}" }
          }
        },
        {
          "name": "Delete category (admin token)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/categories/8", "host": ["{{baseUrl}}"], "path": ["categories", "8"] }
          }
        },
        {
          "name": "Delete category as non-admin - BLOCKED (403)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": { "raw": "{{baseUrl}}/categories/3", "host": ["{{baseUrl}}"], "path": ["categories", "3"] }
          }
        }
      ]
    },
    {
      "name": "Transactions",
      "item": [
        {
          "name": "Create transaction",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/transactions", "host": ["{{baseUrl}}"], "path": ["transactions"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": 1,\n  \"categoryId\": 3,\n  \"type\": \"expense\",\n  \"amount\": 75000,\n  \"description\": \"Snacks\",\n  \"transactionDate\": \"2026-02-21\"\n}"
            }
          }
        },
        {
          "name": "Create transaction - validation error (400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/transactions", "host": ["{{baseUrl}}"], "path": ["transactions"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": 1,\n  \"categoryId\": 3,\n  \"type\": \"expense\",\n  \"amount\": -50,\n  \"transactionDate\": \"not-a-date\"\n}"
            }
          }
        },
        {
          "name": "List transactions",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/transactions", "host": ["{{baseUrl}}"], "path": ["transactions"] }
          }
        },
        {
          "name": "Get transaction",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/transactions/1", "host": ["{{baseUrl}}"], "path": ["transactions", "1"] }
          }
        },
        {
          "name": "Update transaction",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/transactions/23", "host": ["{{baseUrl}}"], "path": ["transactions", "23"] },
            "body": { "mode": "raw", "raw": "{\n  \"amount\": 90000\n}" }
          }
        },
        {
          "name": "Delete transaction",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/transactions/23", "host": ["{{baseUrl}}"], "path": ["transactions", "23"] }
          }
        }
      ]
    }
  ],
  "variable": [{ "key": "baseUrl", "value": "http://localhost:3000" }]
}
